# ED
:CMC is op=0xED & DPB {
	CF = CF ^ 1;
}

# EE
:PLY is op=0xEE & DPB {
	pop8(Y);
}

# EF
:WAI is op=0xEF & DPB {
	sleep();
}

# F0
:BEQ RADDR8 is op=0xF0 & DPB; RADDR8 {
	if (ZF == 1) goto RADDR8;
}

# F1
:JST tcalln is op=0xF1 & tcalln & DPB {
	local ret:2 = inst_next; push16(ret);
	local vec:2 = 0xffde - 2 * tcalln;
	local t:2 = *:2 vec;
	call [t];
}

# F2
:CLR ADDR8^":"^bitno is op=0xF2 & bitno & DPB; ADDR8 {
