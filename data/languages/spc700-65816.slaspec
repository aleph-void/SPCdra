}

# E3
:BBS ADDR8^":"^bitno^"="^RADDR8 is op=0xE3 & bitno & DPB; ADDR8; RADDR8 {
	local v:1 = *:1 ADDR8;
	if (((v >> bitno) & 1) != 0) goto RADDR8;
}

# E4
:LDA ADDR8 is op=0xE4 & DPB; ADDR8 {
	local sea:2 = ADDR8; local val:1 = *:1 sea;
	A = val;
	nz(A);
}

# E5
:LDA ADDR16 is op=0xE5 & DPB; ADDR16 {
	local sea:2 = ADDR16; local val:1 = *:1 sea;
	A = val;
	nz(A);
}

# E6
:LDA "(X)" is op=0xE6 & DPB {
	local sea:2 = DPB | zext(X); local val:1 = *:1 sea;
	A = val;
	nz(A);
}

# E7
:LDA "("^ADDR8^",X)" is op=0xE7 & DPB; ADDR8 {
	local seaptr:2 = (ADDR8 & 0xff00) | ((ADDR8 + zext(X)) & 0xff); local sea:2; readdpw(sea, seaptr); local val:1 = *:1 sea;
	A = val;
	nz(A);
}

# E8
:LDA "#"^imm8 is op=0xE8 & DPB; imm8 {
	local val:1 = imm8;
	A = val;
	nz(A);
}

# E9
:LDX ADDR16 is op=0xE9 & DPB; ADDR16 {
	local sea:2 = ADDR16; local val:1 = *:1 sea;
	X = val;
	nz(X);
}

# EA
:NOT MEMBIT is op=0xEA & DPB; MEMBIT & membitno {
	local v:1 = *:1 MEMBIT;
	*:1 MEMBIT = v ^ (1 << membitno);
}

# EB
:LDY ADDR8 is op=0xEB & DPB; ADDR8 {
