	*:1 ea = val;
}

# D7
:STA "("^ADDR8^"),Y" is op=0xD7 & DPB; ADDR8 {
	local val:1 = A;
	local eaptr:2; readdpw(eaptr, ADDR8); local ea:2 = eaptr + zext(Y);
	*:1 ea = val;
}

# D8
:STX ADDR8 is op=0xD8 & DPB; ADDR8 {
	local val:1 = X;
	local ea:2 = ADDR8;
	*:1 ea = val;
}

# D9
:STX ADDR8^",Y" is op=0xD9 & DPB; ADDR8 {
	local val:1 = X;
	local ea:2 = (ADDR8 & 0xff00) | ((ADDR8 + zext(Y)) & 0xff);
	*:1 ea = val;
}

# DA
:STW ADDR8 is op=0xDA & DPB; ADDR8 {
	writedpw(ADDR8, YA);
}

# DB
:STY ADDR8^",X" is op=0xDB & DPB; ADDR8 {
	local val:1 = Y;
	local ea:2 = (ADDR8 & 0xff00) | ((ADDR8 + zext(X)) & 0xff);
	*:1 ea = val;
}

# DC
:DEY is op=0xDC & DPB {
	local v:1 = Y;
	v = v - 1;
	nz(v);
	Y = v;
}

# DD
:TYA is op=0xDD & DPB {
	A = Y;
	nz(A);
}

# DE
:BNE ADDR8^",X="^RADDR8 is op=0xDE & DPB; ADDR8; RADDR8 {
	local ea:2 = (ADDR8 & 0xff00) | ((ADDR8 + zext(X)) & 0xff);
	local v:1 = *:1 ea;
	if (A != v) goto RADDR8;
}

# DF
:DAA is op=0xDF & DPB {
	daa();
}

# E0
:CLV is op=0xE0 & DPB {
	VF = 0;
	HF = 0;
}

# E1
:JST tcalln is op=0xE1 & tcalln & DPB {
	local ret:2 = inst_next; push16(ret);
	local vec:2 = 0xffde - 2 * tcalln;
	local t:2 = *:2 vec;
	call [t];
}

# E2
:SET ADDR8^":"^bitno is op=0xE2 & bitno & DPB; ADDR8 {
