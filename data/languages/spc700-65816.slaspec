:STC MEMBIT is op=0xCA & DPB; MEMBIT & membitno {
	local v:1 = *:1 MEMBIT;
	*:1 MEMBIT = (v & ~(1 << membitno)) | (CF << membitno);
}

# CB
:STY ADDR8 is op=0xCB & DPB; ADDR8 {
	local val:1 = Y;
	local ea:2 = ADDR8;
	*:1 ea = val;
}

# CC
:STY ADDR16 is op=0xCC & DPB; ADDR16 {
	local val:1 = Y;
	local ea:2 = ADDR16;
	*:1 ea = val;
}

# CD
:LDX "#"^imm8 is op=0xCD & DPB; imm8 {
	local val:1 = imm8;
	X = val;
	nz(X);
}

# CE
:PLX is op=0xCE & DPB {
	pop8(X);
}

# CF
:MUL is op=0xCF & DPB {
	YA = zext(Y) * zext(A);
	nz(Y);
}

# D0
:BNE RADDR8 is op=0xD0 & DPB; RADDR8 {
	if (ZF == 0) goto RADDR8;
}

# D1
:JST tcalln is op=0xD1 & tcalln & DPB {
	local ret:2 = inst_next; push16(ret);
	local vec:2 = 0xffde - 2 * tcalln;
	local t:2 = *:2 vec;
	call [t];
}

# D2
:CLR ADDR8^":"^bitno is op=0xD2 & bitno & DPB; ADDR8 {
	local v:1 = *:1 ADDR8;
	*:1 ADDR8 = v & ~(1 << bitno);
}

# D3
:BBC ADDR8^":"^bitno^"="^RADDR8 is op=0xD3 & bitno & DPB; ADDR8; RADDR8 {
	local v:1 = *:1 ADDR8;
