}

# F4
:LDA ADDR8^",X" is op=0xF4 & DPB; ADDR8 {
	local sea:2 = (ADDR8 & 0xff00) | ((ADDR8 + zext(X)) & 0xff); local val:1 = *:1 sea;
	A = val;
	nz(A);
}

# F5
:LDA ADDR16^",X" is op=0xF5 & DPB; ADDR16 {
