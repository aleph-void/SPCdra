	A = val;
	nz(A);
}

# F7
:LDA "("^ADDR8^"),Y" is op=0xF7 & DPB; ADDR8 {
	local seaptr:2; readdpw(seaptr, ADDR8); local sea:2 = seaptr + zext(Y); local val:1 = *:1 sea;
	A = val;
	nz(A);
}

# F8
:LDX ADDR8 is op=0xF8 & DPB; ADDR8 {
	local sea:2 = ADDR8; local val:1 = *:1 sea;
	X = val;
	nz(X);
}

# F9
:LDX ADDR8^",Y" is op=0xF9 & DPB; ADDR8 {
	local sea:2 = (ADDR8 & 0xff00) | ((ADDR8 + zext(Y)) & 0xff); local val:1 = *:1 sea;
	X = val;
	nz(X);
}

# FA
:STR ADDR8^"="^SDP is op=0xFA & DPB; SDP; ADDR8 {
	local sea:2 = SDP; local val:1 = *:1 sea;
	local ea:2 = ADDR8;
	*:1 ea = val;
}

# FB
:LDY ADDR8^",X" is op=0xFB & DPB; ADDR8 {
	local sea:2 = (ADDR8 & 0xff00) | ((ADDR8 + zext(X)) & 0xff); local val:1 = *:1 sea;
	Y = val;
	nz(Y);
}

# FC
:INY is op=0xFC & DPB {
	local v:1 = Y;
	v = v + 1;
	nz(v);
	Y = v;
}

# FD
:TAY is op=0xFD & DPB {
	Y = A;
	nz(Y);
}

# FE
:BNE "--Y="^RADDR8 is op=0xFE & DPB; RADDR8 {
	Y = Y - 1;
	if (Y != 0) goto RADDR8;
}

# FF
:STP is op=0xFF & DPB {
