# Common definitions for the SPC700 processor definitions.
# The instruction constructors are generated by tools/gen_spc700.py.
define endian=little;
define alignment=1;

define space ram     type=ram_space      size=2  default;
define space register type=register_space size=1;

# YA is the 16-bit pair used by MOVW/ADDW/SUBW/CMPW/MUL/DIV: A is the low byte, Y the high.
define register offset=0x00 size=2 [ YA ];
define register offset=0x00 size=1 [ A Y X ];
define register offset=0x04 size=2 [ PC SP ];
# PSW flags, one byte each (PUSH/POP PSW, BRK and RETI pack and unpack them).
define register offset=0x10 size=1 [ CF ZF IF HF BF PF VF NF ];
define register offset=0x40 size=4 contextreg;
define context contextreg
    # Direct-page select (PSW.P) for decoding: SETP/CLRP set it for the code that follows, so
    # direct-page operands get constant addresses ($00xx or $01xx).
    ctx_P=(0,0)
;

define token opcode (8)
   op       = (0,7)
   tcalln   = (4,7)
   bitno    = (5,7)
;

define token data8 (8)
   imm8     = (0,7)
   simm8    = (0,7) signed
;

define token data16 (16)
   imm16    = (0,15)
   mb_addr  = (0,12)
   membitno = (13,15)
;

# Direct-page base for (X), (Y) and indexed direct-page modes.
DPB: is ctx_P=0 { export 0:2; }
DPB: is ctx_P=1 { export 0x100:2; }

# Direct-page operand: exports the address (shown as the 8-bit offset).
DP1: dpa is imm8 [ dpa = 0x100 + imm8; ] { export *[const]:2 dpa; }
ADDR8: imm8 is ctx_P=0 & imm8 { export *[const]:2 imm8; }
ADDR8: imm8 is ctx_P=1 & imm8 & DP1 { export DP1; }
# Source direct-page operand of the "dp,dp" forms (encoded before the destination).
SDP: imm8 is ctx_P=0 & imm8 { export *[const]:2 imm8; }
SDP: imm8 is ctx_P=1 & imm8 & DP1 { export DP1; }

# Absolute operand: exports the address; ADDR16J is the code location for JMP/CALL.
ADDR16: imm16 is imm16 { export *[const]:2 imm16; }
ADDR16J: imm16 is imm16 { export *:1 imm16; }

# PCALL: call $FF00 + u (shown as u).
UPA: upa is imm8 [ upa = 0xff00 + imm8; ] { export *:1 upa; }
UPAGE: imm8 is imm8 & UPA { export UPA; }

# Relative branch target (16-bit wrap).
RADDR8: addr is simm8 [ addr = (inst_next + simm8) & 0xffff; ] { export *:1 addr; }


################################################################
# Macros. Macro locals share the caller's namespace, so they use macro-specific names.
################################################################
macro nz(nz_v) {
	ZF = (nz_v == 0);
	NF = (nz_v s< 0);
}

macro nz16(nz16_v) {
	ZF = (nz16_v == 0);
	NF = (nz16_v s< 0);
}

# Stack: page 1, post-decrement push, pre-increment pull.
macro push8(push8_v) {
	*:1 SP = push8_v;
	SP = 0x100 | ((SP - 1) & 0xff);
}

macro pop8(pop8_v) {
	SP = 0x100 | ((SP + 1) & 0xff);
	pop8_v = *:1 SP;
}

macro push16(push16_v) {
	local push16_w:2 = push16_v;
	local push16_h:1 = push16_w(1);
	local push16_l:1 = push16_w:1;
	push8(push16_h);
	push8(push16_l);
}

macro pop16(pop16_v) {
	local pop16_lo:1;
	local pop16_hi:1;
	pop8(pop16_lo);
	pop8(pop16_hi);
	pop16_v = (zext(pop16_hi) << 8) | zext(pop16_lo);
}

macro packpsw(pk_out) {
	pk_out = (NF << 7) | (VF << 6) | (PF << 5) | (BF << 4) | (HF << 3) | (IF << 2) | (ZF << 1) | CF;
}

macro unpackpsw(up_in) {
	NF = (up_in >> 7) & 1;
	VF = (up_in >> 6) & 1;
	PF = (up_in >> 5) & 1;
	BF = (up_in >> 4) & 1;
	HF = (up_in >> 3) & 1;
	IF = (up_in >> 2) & 1;
	ZF = (up_in >> 1) & 1;
	CF = up_in & 1;
}

# 16-bit direct-page word: the high byte wraps within the page.
macro readdpw(rw_out, rw_addr) {
	local rw_a:2 = rw_addr;
	local rw_hi:2 = (rw_a & 0xff00) | ((rw_a + 1) & 0xff);
	local rw_l:1 = *:1 rw_a;
	local rw_h:1 = *:1 rw_hi;
	rw_out = (zext(rw_h) << 8) | zext(rw_l);
}

macro writedpw(ww_addr, ww_v) {
	local ww_a:2 = ww_addr;
	local ww_val:2 = ww_v;
	local ww_hi:2 = (ww_a & 0xff00) | ((ww_a + 1) & 0xff);
	local ww_l:1 = ww_val:1;
	local ww_h:1 = ww_val(1);
	*:1 ww_a = ww_l;
	*:1 ww_hi = ww_h;
}

macro compare(cmp_a, cmp_b) {
	local cmp_x:1 = cmp_a;
	local cmp_y:1 = cmp_b;
	local cmp_r:1 = cmp_x - cmp_y;
	CF = cmp_x >= cmp_y;
	nz(cmp_r);
}

macro adc(adc_res, adc_a, adc_b) {
	local adc_x:1 = adc_a;
	local adc_y:1 = adc_b;
	local adc_w:2 = zext(adc_x) + zext(adc_y) + zext(CF);
	local adc_r:1 = adc_w:1;
	HF = ((adc_x ^ adc_y ^ adc_r) & 0x10) != 0;
	VF = (~(adc_x ^ adc_y) & (adc_x ^ adc_r) & 0x80) != 0;
	CF = adc_w > 0xff;
	nz(adc_r);
	adc_res = adc_r;
}

# SBC is ADC of the complemented operand (C = no borrow, H = no half-borrow).
macro sbc(sbc_res, sbc_a, sbc_b) {
	local sbc_y:1 = ~sbc_b;
	adc(sbc_res, sbc_a, sbc_y);
}

macro addw(aw_w) {
	local aw_x:2 = YA;
	local aw_y:2 = aw_w;
	local aw_l:4 = zext(aw_x) + zext(aw_y);
	local aw_r:2 = aw_l:2;
	HF = ((aw_x ^ aw_y ^ aw_r) & 0x1000) != 0;
	VF = (~(aw_x ^ aw_y) & (aw_x ^ aw_r) & 0x8000) != 0;
	CF = aw_l > 0xffff;
	nz16(aw_r);
	YA = aw_r;
}

macro subw(sw_w) {
	local sw_x:2 = YA;
	local sw_y:2 = ~sw_w;
	local sw_l:4 = zext(sw_x) + zext(sw_y) + 1;
	local sw_r:2 = sw_l:2;
	HF = ((sw_x ^ sw_y ^ sw_r) & 0x1000) != 0;
	VF = (~(sw_x ^ sw_y) & (sw_x ^ sw_r) & 0x8000) != 0;
	CF = sw_l > 0xffff;
	nz16(sw_r);
	YA = sw_r;
}

# DIV YA,X as the hardware computes it, including the quotient-overflow results
# (algorithm as in bsnes/higan's SPC700 core).
macro divide() {
	local dv_ya:4 = zext(YA);
	local dv_x:4 = zext(X);
	local dv_y:4 = zext(Y);
	HF = (dv_y & 15) >= (dv_x & 15);
	VF = dv_y >= dv_x;
	local dv_q:4;
	local dv_r:4;
	if (dv_y < (dv_x << 1)) goto <dv_normal>;
	local dv_d:4 = 256 - dv_x;
	local dv_t:4 = dv_ya - (dv_x << 9);
	dv_q = 255 - (dv_t / dv_d);
	dv_r = dv_x + (dv_t % dv_d);
	goto <dv_done>;
	<dv_normal>
	dv_q = dv_ya / dv_x;
	dv_r = dv_ya % dv_x;
	<dv_done>
	A = dv_q:1;
	Y = dv_r:1;
	nz(A);
}

macro daa() {
	if (CF == 0 && A <= 0x99) goto <daa_lo>;
	A = A + 0x60;
	CF = 1;
	<daa_lo>
	if (HF == 0 && (A & 15) <= 9) goto <daa_end>;
	A = A + 6;
	<daa_end>
	nz(A);
}

macro das() {
	if (CF == 1 && A <= 0x99) goto <das_lo>;
	A = A - 0x60;
	CF = 0;
	<das_lo>
	if (HF == 1 && (A & 15) <= 9) goto <das_end>;
	A = A - 6;
	<das_end>
	nz(A);
}
